import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while (t-- > 0) {
            int n = sc.nextInt();
            int k = sc.nextInt();

            String s = sc.next();

            int answer = 0;

            // Check every farm
            for (int i = 0; i < n; i += k) {

                boolean allOne = true;

                // Check k fields in this farm
                for (int j = i; j < i + k; j++) {
                    if (s.charAt(j) == '0') {
                        allOne = false;
                        break;
                    }
                }

                if (allOne) {
                    answer++;
                }
            }

            System.out.println(answer);
        }

        sc.close();
    }
}
