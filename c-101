import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while (t-- > 0) {
            int n = sc.nextInt();

            int[] a = new int[n];

            int firstOne = -1;
            int lastOne = -1;

            for (int i = 0; i < n; i++) {
                a[i] = sc.nextInt();

                if (a[i] == 1) {
                    if (firstOne == -1) {
                        firstOne = i;
                    }
                    lastOne = i;
                }
            }

            if (firstOne == -1) {
                // No fixed 1 exists.
                // Put 1 at both ends and 0 everywhere else.
                a[0] = 1;

                for (int i = 1; i < n; i++) {
                    a[i] = 0;
                }

                if (n > 1) {
                    a[n - 1] = 1;
                }
            } else {
                // Make all -1s between first and last 1 equal to 0
                for (int i = firstOne; i <= lastOne; i++) {
                    if (a[i] == -1) {
                        a[i] = 0;
                    }
                }

                // Outside the fixed 1s, make -1s zero.
                // Keeping them zero is safe.
                for (int i = 0; i < firstOne; i++) {
                    if (a[i] == -1) {
                        a[i] = 0;
                    }
                }

                for (int i = lastOne + 1; i < n; i++) {
                    if (a[i] == -1) {
                        a[i] = 0;
                    }
                }
            }

            for (int i = 0; i < n; i++) {
                System.out.print(a[i] + " ");
            }

            System.out.println();
        }

        sc.close();
    }
}
